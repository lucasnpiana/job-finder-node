
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Finder</title>

    <script>
        (function () {
            var saved = null;

            try {
                saved = localStorage.getItem('theme');
            } catch (e) {}

            var theme = saved ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches
                    ? 'dark' : 'light');

            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <header>
        <nav class="navbar fixed-top navbar-expand-md">
            <div class="container-fluid">

                <a class="navbar-brand" href="/">Job Finder</a>

                <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav ms-auto align-items-md-center">

                        <li class="nav-item">
                            <a class="nav-link" href="/#vagas">
                                Ver Vagas
                            </a>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="theme-toggle"
                                id="themeToggle"
                                aria-label="Alternar modo claro e escuro">
                            </button>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link btn btn-primary" href="/add">
                                Abrir Vaga
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    {{{body}}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            var root = document.documentElement;
            var btn = document.getElementById('themeToggle');

            function render() {
                var dark = root.getAttribute('data-bs-theme') === 'dark';

                btn.textContent = dark ? '☀ Claro' : '☾ Escuro';
                btn.setAttribute('aria-pressed', dark);
            }

            btn.addEventListener('click', function () {
                var next = root.getAttribute('data-bs-theme') === 'dark'
                    ? 'light' : 'dark';

                root.setAttribute('data-bs-theme', next);

                try {
                    localStorage.setItem('theme', next);
                } catch (e) {}

                render();
            });

            render();
        })();
    </script>

</body>
</html>
